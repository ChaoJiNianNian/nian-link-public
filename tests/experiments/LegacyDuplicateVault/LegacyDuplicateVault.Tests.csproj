<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MultiPeerTrust.Tests</AssemblyName>
    <_LegacyWorkRoot>$([System.String]::Copy('$([MSBuild]::NormalizeDirectory("$(MSBuildThisFileDirectory)../../.work"))').ToUpperInvariant())</_LegacyWorkRoot>
    <_LegacyArtifacts Condition="'$(ArtifactsPath)' != ''">$([System.String]::Copy('$([MSBuild]::NormalizeDirectory("$(ArtifactsPath)"))').ToUpperInvariant())</_LegacyArtifacts>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="NianLegacyDuplicateRoot" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../.work/legacy-duplicate-vault'))" />
    <ProjectReference Include="../../../src/DesktopToolbox.DeskLink/DesktopToolbox.DeskLink.csproj" />
    <Compile Include="../../../src/NianLink.Windows/WindowsCredentialProtector.cs" Link="WindowsCredentialProtector.cs" />
  </ItemGroup>
  <Target Name="RequireIsolatedLegacyDuplicateArtifacts" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UseArtifactsOutput)' != 'true' Or '$(_LegacyArtifacts)' == ''" Text="Legacy vault research requires isolated test artifacts." />
    <Error Condition="!$([System.String]::Copy('$(_LegacyArtifacts)').StartsWith('$(_LegacyWorkRoot)'))" Text="Legacy vault research artifacts must remain inside tests/.work." />
  </Target>
</Project>
