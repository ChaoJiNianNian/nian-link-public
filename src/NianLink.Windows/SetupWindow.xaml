<Window x:Class="NianLink.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="年年互联 · 连接设置" Width="720" Height="820" MinWidth="570" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" Background="#F1F5FB">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#243A59"/>
        <SolidColorBrush x:Key="Muted" Color="#7589A5"/>
        <SolidColorBrush x:Key="Accent" Color="#397DF1"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#DDFBFDFF"/>
            <Setter Property="BorderBrush" Value="#D7E3F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#F5F8FD"/>
            <Setter Property="BorderBrush" Value="#D4E0EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="#397DF1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#3D587B"/>
            <Setter Property="Background" Value="#EDF3FB"/>
            <Setter Property="BorderBrush" Value="#D7E3F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.62"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4F8BF1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#D9E8FF"/>
            <Setter Property="BorderBrush" Value="#C4DAF9"/>
            <Setter Property="Foreground" Value="#2866CF"/>
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#F4F8FD"/>
            <Setter Property="BorderBrush" Value="#D6E3F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#243A59"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#E6F0FF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#D9E9FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="Open" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    BorderThickness="1" CornerRadius="11"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9ABCEF"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#76A4ED"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock x:Name="Selected" Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <TextBlock x:Name="Placeholder" Text="选择接口" Margin="13,0,34,0" VerticalAlignment="Center"
                               Foreground="#91A2B7" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#8295B0" StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,15,0" IsHitTestVisible="False"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="240" Margin="0,5,0,0" Padding="5" Background="#FBFDFF"
                                BorderBrush="#D6E3F1" BorderThickness="1" CornerRadius="12">
                            <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="SelectedItem" Value="{x:Null}"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Open" Property="Opacity" Value="0.5"/><Setter TargetName="Selected" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" Padding="2,4">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbSurface" Background="#B9CBE1" CornerRadius="3"/>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#84A9DB"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="13"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F9FBFE" Offset="0"/><GradientStop Color="#EDF4FC" Offset="0.52"/><GradientStop Color="#E7F0FA" Offset="1"/>
        </LinearGradientBrush></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#CFFBFDFF" BorderBrush="#DCE7F3" BorderThickness="0,0,0,1" Padding="26,16">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="打开互联小窗" Style="{StaticResource Action}" Click="OpenMini_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform"
                           Source="/NianLink;component/Assets/NianLinkBrand.png"/>
                    <StackPanel><TextBlock Text="年年互联" Style="{StaticResource Title}"/><TextBlock Text="连接与显示器设置" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="SetupScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
            <StackPanel Margin="26,22,26,28">
                <TextBlock Text="让两台电脑连起来" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="连接后，可切换电脑、传送文件和查看对方画面。" Style="{StaticResource Label}" FontSize="13" Margin="0,7,0,16"/>
                <Border Style="{StaticResource Card}" Background="#DCE9F4FF" BorderBrush="#C8DEF6" Padding="17,14">
                    <DockPanel><TextBlock DockPanel.Dock="Left" Text="●" Foreground="#71BDA0" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <StackPanel><TextBlock x:Name="StatusText" Style="{StaticResource Title}" FontSize="14"/><TextBlock x:Name="StatusDetail" Style="{StaticResource Label}" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="准备 Mac 端" Style="{StaticResource Title}"/>
                    <TextBlock Text="将安装包发到自己的 Mac，安装后即可配对。" Style="{StaticResource Label}" Margin="0,6,0,12"/>
                    <Button x:Name="MacExportButton" Content="Mac 安装包准备中" IsEnabled="False" Style="{StaticResource Action}" HorizontalAlignment="Left" Click="ExportMac_Click"/>
                    <TextBlock x:Name="MacExportFeedback" Foreground="#55779D" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Background="#E6F0FF" Margin="0,0,11,0">
                            <TextBlock Text="1" Foreground="#4E84E3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="开启共享" Style="{StaticResource Title}"/><TextBlock Text="先在这台 Windows 上启动共享。" Style="{StaticResource Label}" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="39,14,0,2"><Button Content="启动共享" Style="{StaticResource Primary}" Click="Start_Click" Margin="0,0,9,8"/>
                        <Button Content="停止共享" Style="{StaticResource Action}" Click="Stop_Click" Margin="0,0,0,8"/></WrapPanel>
                    <Expander Header="设备名称（可选）" Margin="39,3,0,0"><StackPanel Margin="0,12,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Windows 名称" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox x:Name="LocalName" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Mac 名称" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox x:Name="RemoteName" Style="{StaticResource Field}"/></StackPanel>
                        </Grid>
                        <Button Content="保存名称" Style="{StaticResource Action}" Click="Save_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel></Expander>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Background="#E6F0FF" Margin="0,0,11,0">
                            <TextBlock Text="2" Foreground="#4E84E3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="配对你的 Mac" Style="{StaticResource Title}"/><TextBlock Text="导出文件，通过微信发到自己的 Mac 并导入。" Style="{StaticResource Label}" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="39,14,0,0"><Button Content="导出配对文件" Style="{StaticResource Primary}" Click="Export_Click" Margin="0,0,9,0"/>
                        <Button x:Name="RevealExport" Content="打开所在文件夹" Style="{StaticResource Action}" Click="RevealExport_Click" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock x:Name="ExportFeedback" Foreground="#55779D" FontSize="12" TextWrapping="Wrap" Margin="39,10,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="配对文件含连接凭证，只发给自己的设备。" Style="{StaticResource Label}" Margin="39,10,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Background="#E6F0FF" Margin="0,0,11,0">
                            <TextBlock Text="3" Foreground="#4E84E3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel><TextBlock Text="确认设备" Style="{StaticResource Title}"/><TextBlock Text="核对两端的完整安全指纹，一致后确认。" Style="{StaticResource Label}" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <Border Background="#EEF5FD" CornerRadius="12" Padding="12" Margin="39,14,0,0">
                        <TextBlock x:Name="FingerprintText" Foreground="#58728F" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="核对并信任 Mac" Style="{StaticResource Action}" HorizontalAlignment="Left" Click="Confirm_Click" Margin="39,12,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <Expander x:Name="AdvancedSettings">
                        <Expander.Header><StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#E6F0FF" Margin="0,0,10,0">
                                <TextBlock Text="▣" Foreground="#4E84E3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel><TextBlock Text="显示器切换" Style="{StaticResource Title}"/><TextBlock Text="切换电脑时，画面跟着一起切换" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
                        </StackPanel></Expander.Header>
                        <StackPanel Margin="0,16,0,0">
                            <Border Background="#F0F6FD" CornerRadius="12" Padding="13,11" Margin="0,0,0,15">
                                <TextBlock Text="普通切换会切换显示器画面；预览操作只交接键鼠，画面不切换。" Style="{StaticResource Label}"/>
                            </Border>
                            <CheckBox x:Name="DisplayLink" Content="切换电脑时同时切换画面" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="选择连接两台电脑的显示器" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ListBox x:Name="MonitorList" MinHeight="46" MaxHeight="140" Background="#F4F8FD" BorderBrush="#D6E3F1" Foreground="#344C6B" DisplayMemberPath="Label" SelectionChanged="MonitorList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="11,9"/><Setter Property="Foreground" Value="#344C6B"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E6F0FF"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DBEAFF"/><Setter Property="Foreground" Value="#285EAC"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#79A4E9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style></ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock x:Name="MonitorFeedback" Text="先检测显示器，再选择你的设备。" Style="{StaticResource Label}" Margin="0,9,0,0"/>
                            <Button Content="检测显示器" Style="{StaticResource Action}" HorizontalAlignment="Left" Click="Monitors_Click" Margin="0,12,0,0"/>
                            <TextBlock Text="两台电脑分别接在哪个接口？" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,5"/>
                            <TextBlock Text="根据显示器线缆选择；下方是显示器支持的接口。" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Windows 连接的接口" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="WindowsInputChoice" Style="{StaticResource Choice}" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="Windows 连接的接口"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Mac 连接的接口" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MacInputChoice" Style="{StaticResource Choice}" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="Mac 连接的接口"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,15,0,0"><Button x:Name="SaveDisplayButton" Content="保存设置" Style="{StaticResource Primary}" Click="SaveDisplay_Click" Margin="0,0,9,8"/>
                                <Button Content="导入旧设置" Style="{StaticResource Action}" Click="ImportDisplay_Click" Margin="0,0,0,8"/></WrapPanel>
                            <TextBlock Text="保存前请先停止共享。设置变化后，需重新发配对文件给 Mac。" Style="{StaticResource Label}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></Border>
                <Button Content="退出年年互联" Style="{StaticResource Action}" HorizontalAlignment="Right" Click="Exit_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
