<Window x:Class="NianLink.MultiDevice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NianLink.MultiDevice"
        Title="年年互联 · 多设备测试" Width="980" Height="760" MinWidth="620" MinHeight="580"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" Background="#EDF4FC">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsScrollBars.xaml"/><ResourceDictionary Source="SettingsVisuals.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Ink" Color="#21324B"/>
        <SolidColorBrush x:Key="Muted" Color="#617793"/>
        <local:DeviceLabelConverter x:Key="DeviceLabelConverter"/>
        <local:DeviceConnectionConverter x:Key="DeviceConnectionConverter"/>
        <local:DeviceSwitchAvailableConverter x:Key="DeviceSwitchAvailableConverter"/>
        <local:DevicePlatformConverter x:Key="DevicePlatformConverter"/>
        <local:DevicePlatformIconConverter x:Key="DevicePlatformIconConverter"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E4EBF4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#E4EFFF"/><Setter Property="Foreground" Value="#2D63BC"/><Setter Property="BorderBrush" Value="#D1E2F8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3975E7"/><Setter Property="BorderBrush" Value="#3975E7"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="150"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#65768B"/><Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Margin="0,0,6,0"><Path x:Name="Symbol" Data="{StaticResource IconConnect}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox><ContentPresenter VerticalAlignment="Center"/></StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF2FF"/><Setter TargetName="Surface" Property="BorderBrush" Value="#BED4F0"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3975E7"/></Trigger>
                    <Trigger Property="Tag" Value="HostPairingCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconPair}"/></Trigger><Trigger Property="Tag" Value="PeerPairingCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconPair}"/></Trigger>
                    <Trigger Property="Tag" Value="HostDevicesCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconDevices}"/></Trigger><Trigger Property="Tag" Value="PeerDevicesCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconMouse}"/></Trigger>
                    <Trigger Property="Tag" Value="PeerSummaryCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconDevices}"/></Trigger><Trigger Property="Tag" Value="HostKeyboardCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconMouse}"/></Trigger>
                    <Trigger Property="Tag" Value="HostDisplayCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconDisplay}"/></Trigger>
                    <Trigger Property="Tag" Value="HostPreviewCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconPreview}"/></Trigger><Trigger Property="Tag" Value="PeerPreviewCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconPreview}"/></Trigger>
                    <Trigger Property="Tag" Value="HostFilesCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconFiles}"/></Trigger><Trigger Property="Tag" Value="PeerFilesCard"><Setter TargetName="Symbol" Property="Data" Value="{StaticResource IconFiles}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#F6F9FD"/><Setter Property="BorderBrush" Value="#D9E5F4"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="WorkspaceTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><TabPanel IsItemsHost="True" Visibility="Collapsed"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="RoleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#65768B"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0"/></Style>
        <Style x:Key="HostRoleStyle" TargetType="Button" BasedOn="{StaticResource RoleButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ModeTabs}" Value="0"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1B2C43"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="PeerRoleStyle" TargetType="Button" BasedOn="{StaticResource RoleButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ModeTabs}" Value="1"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1B2C43"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#7287A3"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E7F0FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#DCEAFF"/><Setter Property="Foreground" Value="#2D63BC"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,7,0,10"/><Setter Property="Foreground" Value="#243A59"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="#F5F8FD" BorderBrush="#D9E5F4" BorderThickness="1" CornerRadius="10"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#A3BFE6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#8295B0" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="200" Margin="0,5,0,0" Padding="5" Background="#FBFDFF" BorderBrush="#D6E3F1" BorderThickness="1" CornerRadius="10"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#243A59"/></Style></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#F5F8FD"/><Setter Property="BorderBrush" Value="#D9E5F4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/></Style>
      </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Background><SolidColorBrush Color="#F6F9FF"/></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#E4EBF4" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="#EDF4FF" CornerRadius="10" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="HostRoleButton" Content="Windows 主控" Tag="0" Click="SelectWorkspaceRole_Click" IsEnabled="{Binding IsEnabled, ElementName=ModeTabs}" Style="{StaticResource HostRoleStyle}"/><Button x:Name="PeerRoleButton" Content="Windows 被控" Tag="1" Click="SelectWorkspaceRole_Click" IsEnabled="{Binding IsEnabled, ElementName=ModeTabs}" Style="{StaticResource PeerRoleStyle}"/></StackPanel></Border><StackPanel Orientation="Horizontal"><Image x:Name="BrandLogo" Width="40" Height="40" Margin="0,0,11,0"/><StackPanel><TextBlock Text="年年互联" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="多设备工作空间 · 测试版" Style="{StaticResource Hint}"/></StackPanel></StackPanel></DockPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="0" x:Name="ModeTabs" SelectedIndex="0" Style="{StaticResource WorkspaceTabs}" SelectionChanged="ModeTabs_SelectionChanged">
            <TabItem Header="主控电脑"><DockPanel><Border DockPanel.Dock="Left" Width="174" Padding="12,20" Background="#EDF4FF"><WrapPanel x:Name="HostSections" Orientation="Vertical">
                <Button Content="设备" Tag="HostDevicesCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="发现与配对" Tag="HostPairingCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="画面" Tag="HostPreviewCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="键鼠" Tag="HostKeyboardCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="文件" Tag="HostFilesCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="显示器" Tag="HostDisplayCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
                <Button Content="设置与权限" Tag="HostConnectionCard" Style="{StaticResource SectionButton}" Click="NavigateSettings_Click"/>
            </WrapPanel></Border><ScrollViewer x:Name="HostScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,20">
                <Border x:Name="HostIntroCard" Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="连接你的设备" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="同一局域网 · 键鼠、画面与文件" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <TextBlock Text="键鼠所在电脑选主控；另一台 Windows 选被控。" Foreground="#547BAE" FontSize="12" Margin="0,9,0,10"/>
                    <WrapPanel><Button x:Name="MacExportButton" Content="导出 Mac 测试包" IsEnabled="False" Click="ExportMac_Click" Margin="0,0,8,0"/><TextBlock x:Name="MacExportStatus" Style="{StaticResource Hint}" VerticalAlignment="Center"/></WrapPanel>
                </StackPanel></Border>
                <Border x:Name="HostConnectionCard" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Border Style="{StaticResource SectionIconTile}"><Viewbox Width="18" Height="18"><Path Data="{StaticResource IconConnect}" Stroke="#4B7FCC" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Border><TextBlock Text="1 · 准备这台主控电脑" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="设置名称并选择网络。" Style="{StaticResource Hint}" Margin="0,6,0,12"/><TextBlock Text="本机名称"/><DockPanel Margin="0,8,0,10"><Button DockPanel.Dock="Right" Content="修改名称" Click="RenameLocal_Click" Margin="8,0,0,0"/><Border Background="#F3F7FD" BorderBrush="#DFE9F5" BorderThickness="1" CornerRadius="10" Padding="12,10"><TextBlock x:Name="HostDisplayName" Text="正在准备…" FontWeight="SemiBold"/></Border></DockPanel><TextBox x:Name="HostName" IsReadOnly="True" Text="正在准备…" Visibility="Collapsed"/><TextBlock Text="局域网地址"/><ComboBox x:Name="HostAddress"/><WrapPanel><Button x:Name="HostPrepareButton" Content="准备主控" Style="{StaticResource PrimaryButton}" Click="PrepareHost_Click"/><Button x:Name="HostRefreshNetworkButton" Content="刷新网络" Click="RefreshNetworks_Click"/></WrapPanel><TextBlock x:Name="HostIdentity" Style="{StaticResource Hint}"/></StackPanel></Border>
                <Border x:Name="HostPairingCard" Style="{StaticResource Card}"><StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Style="{StaticResource SectionIconTile}"><Viewbox Width="18" Height="18"><Path Data="{StaticResource IconPair}" Stroke="#4B7FCC" StrokeThickness="1.4"/></Viewbox></Border><TextBlock Text="发现与配对" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="在同一局域网找到设备，并核对双方身份。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                    <TextBlock Text="局域网发现（测试）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <TextBlock Text="先在设置中准备主控，再让另一台 Windows 或 Mac 开启可发现。找到的设备尚未验证，仍需核对完整指纹。" Style="{StaticResource Hint}"/>
                    <WrapPanel><Button Content="扫描设备" Click="StartDiscoveryScan_Click"/><Button Content="停止扫描" Click="StopDiscovery_Click"/></WrapPanel>
                    <ListBox x:Name="DiscoveryChoices" DisplayMemberPath="Name" MinHeight="55" MaxHeight="140"/>
                    <WrapPanel><Button x:Name="HostFilelessPairingStart" Content="开始安全配对" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/><Button x:Name="HostFilelessPairingCancel" Content="取消安全配对" Visibility="Collapsed"/></WrapPanel>
                    <TextBlock x:Name="HostDiscoveryStatus" Style="{StaticResource Hint}"/>
                    <Button x:Name="HostPairingRecovery" Content="查看未完成的配对" Visibility="Collapsed" HorizontalAlignment="Left"/>
                    <Separator Margin="0,14,0,14"/><TextBlock Text="身份卡与配对文件（备用）" FontWeight="SemiBold"/><TextBlock x:Name="HostPairingStep" Text="先准备主控" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="HostPairingGuide" Style="{StaticResource Hint}" Margin="0,7,0,10"/><Button Content="选择发现的设备并生成配对文件" HorizontalAlignment="Left" Click="ChooseDiscoveryCandidate_Click"/>
                    <TextBlock x:Name="OfferDetails" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                    <WrapPanel><Button x:Name="HostPairingPrepare" Content="去准备主控" Tag="HostConnectionCard" Click="NavigateSettings_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="HostPairingImport" Content="导入设备身份卡" Click="ImportOffer_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="HostPairingConfirm" Content="核对并生成配对文件" Click="ConfirmOffer_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="HostPairingRetry" Content="重新选择身份卡" Click="ImportOffer_Click"/>
                        <Button x:Name="HostPairingSave" Content="保存配对文件" Click="SaveInvitation_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="HostPairingDone" Content="查看设备" Tag="HostDevicesCard" Click="NavigateSettings_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="HostPairingAgain" Content="继续添加设备" Click="HostPairingAgain_Click"/>
                    </WrapPanel><TextBlock x:Name="HostPairingHelp" Foreground="#A33336" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel></Border>
                <Border x:Name="HostDevicesCard" Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="＋ 添加设备" Tag="HostPairingCard" Click="NavigateSettings_Click" Style="{StaticResource PrimaryButton}"/><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SectionIconTile}"><Viewbox Width="18" Height="18"><Path Data="{StaticResource IconDevices}" Stroke="#4B7FCC" StrokeThickness="1.4"/></Viewbox></Border><TextBlock Text="我的设备" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
                    <TextBlock Text="选择一台设备进行操作" Style="{StaticResource Hint}" Margin="0,3,0,14"/>
                    <Border x:Name="HostEmptyState" Background="#F5F9FF" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="HostEmptyTitle" Text="还没有设备" FontWeight="SemiBold"/><TextBlock x:Name="HostEmptyHint" Text="先添加另一台电脑，完成安全配对。" Style="{StaticResource Hint}" Margin="0,5,0,10"/><Button x:Name="HostEmptyButton" Content="添加设备" Tag="HostPairingCard" Click="NavigateSettings_Click" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border>
                    <ListBox x:Name="HostDevices" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HostDevices_SelectionChanged">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="DeviceSurface" Background="#F8FBFF" BorderBrush="#DCE8F8" BorderThickness="1" CornerRadius="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeviceSurface" Property="Background" Value="#F0F6FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="DeviceSurface" Property="BorderBrush" Value="#6094E5"/><Setter TargetName="DeviceSurface" Property="Background" Value="#EAF3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Width="250" Margin="14"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SectionIconTile}"><Viewbox Width="18" Height="18"><Path Data="{Binding Platform, Converter={StaticResource DevicePlatformIconConverter}}" Stroke="#4B7FCC" StrokeThickness="1.4" StrokeLineJoin="Round"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name, Converter={StaticResource DeviceLabelConverter}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="192"/><TextBlock Text="{Binding Platform, Converter={StaticResource DevicePlatformConverter}}" FontSize="12" Foreground="#7389A6"/></StackPanel></StackPanel><TextBlock Margin="0,10,0,10" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#65768B"/><Style.Triggers><Trigger Property="Text" Value="● 已连接"><Setter Property="Foreground" Value="#24815D"/></Trigger></Style.Triggers></Style></TextBlock.Style><TextBlock.Text><MultiBinding Converter="{StaticResource DeviceConnectionConverter}"><Binding Path="Name"/><Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="HostKeyboardSnapshot"/></MultiBinding></TextBlock.Text></TextBlock><WrapPanel><Button Content="切换到这台电脑" Style="{StaticResource PrimaryButton}" Click="HostCardSwitch_Click"><Button.IsEnabled><MultiBinding Converter="{StaticResource DeviceSwitchAvailableConverter}"><Binding Path="Name"/><Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="HostKeyboardSnapshot"/><Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="HostSharedRunning"/></MultiBinding></Button.IsEnabled></Button><Button Content="查看画面" Tag="HostPreviewCard" Click="HostCardView_Click"/></WrapPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel><Button x:Name="HostStartButton" Content="启动共享" Style="{StaticResource PrimaryButton}" Click="StartHost_Click"/><Button x:Name="HostStopButton" Content="停止共享" Click="StopHost_Click"/><Button x:Name="HostMiniButton" Content="打开互联小窗" Click="OpenHostMini_Click"/></WrapPanel>
                    <WrapPanel x:Name="HostSelectedActions"><Button x:Name="HostSwitchButton" Content="切换到这台电脑" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="SwitchHost_Click"/><Button x:Name="HostQuickSend" Content="发送文件" Click="HostSend_Click"/><Button x:Name="HostReturnButton" Content="归还主控" Click="ReturnHost_Click"/><Button x:Name="HostMoreButton" Content="更多 ···" Click="HostMore_Click"><Button.ContextMenu><ContextMenu><MenuItem Header="修改名称" Click="RenameSelected_Click"/><MenuItem Header="重新导出配对文件" Click="SaveInvitation_Click"/><Separator/><MenuItem Header="移除设备" Click="RevokeHost_Click"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
                    <Expander x:Name="HostConnectionDetails" Header="连接详情" Foreground="#536D90"><TextBlock x:Name="HostStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/></Expander>
                </StackPanel></Border>
                <Border x:Name="HostKeyboardCard" Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="键鼠共享" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="用一套键盘和鼠标操作已连接的设备。" Style="{StaticResource Hint}" Margin="0,6,0,14"/>
                    <TextBlock Text="当前控制位置" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=HostStatus}" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                    <WrapPanel><Button Content="打开互联小窗" Click="OpenHostMini_Click" IsEnabled="{Binding IsEnabled, ElementName=HostMiniButton}" Visibility="{Binding Visibility, ElementName=HostMiniButton}"/><Button Content="归还主控" Click="ReturnHost_Click" IsEnabled="{Binding IsEnabled, ElementName=HostReturnButton}" Visibility="{Binding Visibility, ElementName=HostSelectedActions}"/></WrapPanel>
                    <TextBlock Text="安全归还" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="快捷键：Ctrl + Alt + F11" Style="{StaticResource Hint}"/>
                    <CheckBox x:Name="HostClipboard" Content="与选中设备同步文字剪贴板" IsEnabled="False" Click="HostClipboard_Click" Margin="0,14,0,0" Foreground="{StaticResource Ink}"/>
                </StackPanel></Border>
                <Border x:Name="HostDisplayCard" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Border Style="{StaticResource SectionIconTile}"><Viewbox Width="18" Height="18"><Path Data="{StaticResource IconDisplay}" Stroke="#4B7FCC" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Border><TextBlock Text="显示器接口" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="选择共用显示器的接口；不共用可留空。" Style="{StaticResource Hint}" Margin="0,6,0,10"/><Button Content="检测显示器" HorizontalAlignment="Left" Click="DetectDisplay_Click"/><ComboBox x:Name="GroupMonitorChoice" DisplayMemberPath="Name" SelectionChanged="GroupMonitorChoice_SelectionChanged"/><StackPanel x:Name="GroupDisplayRows"/><Button Content="保存接口设置" HorizontalAlignment="Left" Click="SaveDisplayGroup_Click"/><TextBlock x:Name="GroupDisplayStatus" Text="接口设置为测试功能；自动切换画面尚未启用。" Style="{StaticResource Hint}"/></StackPanel></Border>
                <Border x:Name="HostPreviewCard" Background="Transparent"><StackPanel>
                    <TextBlock Text="设备画面" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="分别控制你能看到什么，以及对方能看到什么。" Style="{StaticResource Hint}" Margin="0,6,0,10"/><TextBlock x:Name="HostPreviewTarget" Text="当前设备：未选择" FontWeight="SemiBold" Margin="0,0,0,14"/>
