+bool Server::controlSwitchTo(const std::string &target, std::string &error)
+{
+  if (!m_config->isComputer(target)) { error = "unknown_computer"; return false; }
+  const auto canonical = m_config->getCanonicalName(target);
+  const auto found = m_clients.find(canonical);
+  if (found == m_clients.end()) { error = "computer_offline"; return false; }
+  if (m_active == found->second) { error.clear(); return true; }
+  jumpToComputer(found->second);
+  if (m_active != found->second) { error = "switch_rejected"; return false; }
+  error.clear();
+  return true;
 }
 
