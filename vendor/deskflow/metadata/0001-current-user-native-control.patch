@@ -0,0 +1,29 @@
+/*
+ * DesktopToolbox integration for Deskflow.
+ * SPDX-FileCopyrightText: (C) 2026 DesktopToolbox contributors
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+#include "UserLocalServer.h"
+#ifdef Q_OS_UNIX
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+#endif
+void UserLocalServer::incomingConnection(quintptr descriptor)
+{
+#ifdef Q_OS_UNIX
+  bool sameUser = false;
+#if defined(Q_OS_DARWIN) || defined(Q_OS_FREEBSD) || defined(Q_OS_OPENBSD) || defined(Q_OS_NETBSD)
+  uid_t uid = 0;
+  gid_t gid = 0;
+  sameUser = getpeereid(static_cast<int>(descriptor), &uid, &gid) == 0 && uid == geteuid();
+#elif defined(Q_OS_LINUX)
+  struct ucred credentials{};
+  socklen_t length = sizeof(credentials);
+  sameUser = getsockopt(static_cast<int>(descriptor), SOL_SOCKET, SO_PEERCRED, &credentials, &length) == 0 &&
+             length == sizeof(credentials) && credentials.uid == geteuid();
+#endif
+  if (!sameUser) { ::close(static_cast<int>(descriptor)); return; }
+#endif
+  QLocalServer::incomingConnection(descriptor);
+}
