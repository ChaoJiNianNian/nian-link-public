new file mode 100644
--- /dev/null
+++ b/src/lib/deskflow/control/DeskToolboxControl.h
@@ -0,0 +1,39 @@
+/*
+ * DesktopToolbox integration for Deskflow.
+ * SPDX-FileCopyrightText: (C) 2026 DesktopToolbox contributors
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+
+#pragma once
+#include "UserLocalServer.h"
+#include <QHash>
+#include <QJsonObject>
+#include <QLocalServer>
+#include <QLocalSocket>
+#include <QObject>
+#include <QSet>
+#include <functional>
+
+// Owns sockets only on the Qt thread. The submit callback marshals all state access
+// and switching onto Deskflow's native EventQueue thread, then completes asynchronously.
+class DeskToolboxControl final : public QObject
+{
+public:
+  using Complete = std::function<void(QJsonObject)>;
+  using Submit = std::function<void(QJsonObject, Complete)>;
+  explicit DeskToolboxControl(Submit submit, QObject *parent = nullptr);
+  bool listen();
+  QString endpoint() const;
+  void publish(QJsonObject snapshot, bool focusChanged);
+private:
+  static constexpr qsizetype MaxFrame = 16384;
+  struct Client { QByteArray buffer; QSet<QString> pending; };
+  void acceptClients();
+  void readClient(QLocalSocket *socket);
+  void processFrame(QLocalSocket *socket, const QByteArray &frame);
+  void write(QLocalSocket *socket, const QJsonObject &object);
+  void reject(QLocalSocket *socket, const QString &requestId, const QString &reason);
+  UserLocalServer m_server;
+  QHash<QLocalSocket *, Client> m_clients;
+  Submit m_submit;
+};
diff --git a/src/lib/deskflow/control/DeskToolboxControl.cpp b/src/lib/deskflow/control/DeskToolboxControl.cpp
new file mode 100644
--- /dev/null
+++ b/src/lib/deskflow/control/DeskToolboxControl.cpp
@@ -0,0 +1,143 @@
+/*
+ * DesktopToolbox integration for Deskflow.
+ * SPDX-FileCopyrightText: (C) 2026 DesktopToolbox contributors
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+
+#include "DeskToolboxControl.h"
+#include <QCoreApplication>
+#include <QDebug>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonParseError>
+#include <QPointer>
+#include <QRegularExpression>
+
+DeskToolboxControl::DeskToolboxControl(Submit submit, QObject *parent)
+    : QObject(parent), m_server(this), m_submit(std::move(submit))
+{
+  // Never reuse the original system-service IPC's WorldAccessOption here.
+  m_server.setSocketOptions(QLocalServer::UserAccessOption);
+  m_server.setMaxPendingConnections(8);
+  connect(&m_server, &QLocalServer::newConnection, this, [this] { acceptClients(); });
+}
+
+QString DeskToolboxControl::endpoint() const
+{
+  return QStringLiteral("nian-deskflow-control-%1").arg(QCoreApplication::applicationPid());
+}
+
+bool DeskToolboxControl::listen()
+{
+  if (qEnvironmentVariable("DESKTOOLBOX_CONTROL") != QStringLiteral("1"))
+    return false;
+  if (!m_server.listen(endpoint())) {
+    qCritical().noquote() << "DesktopToolbox control cannot listen:" << m_server.errorString();
+    return false;
+  }
+  qInfo().noquote() << "DesktopToolbox current-user control:" << endpoint();
+  return true;
+}
+
+void DeskToolboxControl::acceptClients()
+{
+  while (m_server.hasPendingConnections()) {
+    auto *socket = m_server.nextPendingConnection();
+    if (!socket) continue;
+    if (m_clients.size() >= 8) { socket->abort(); socket->deleteLater(); continue; }
+    socket->setParent(this);
+    socket->setReadBufferSize(MaxFrame + 1);
+    m_clients.insert(socket, Client{});
+    connect(socket, &QLocalSocket::readyRead, this, [this, socket] { readClient(socket); });
+    connect(socket, &QLocalSocket::disconnected, this, [this, socket] {
+      m_clients.remove(socket);
+      socket->deleteLater();
+    });
+  }
+}
+
+void DeskToolboxControl::readClient(QLocalSocket *socket)
+{
+  auto it = m_clients.find(socket);
+  if (it == m_clients.end()) return;
+  it->buffer += socket->readAll();
+  while (true) {
+    const auto newline = it->buffer.indexOf('\n');
+    if (newline < 0) {
+      if (it->buffer.size() > MaxFrame) socket->abort();
+      return;
+    }
+    if (newline > MaxFrame) { socket->abort(); return; }
+    const auto frame = it->buffer.left(newline);
+    it->buffer.remove(0, newline + 1);
+    processFrame(socket, frame);
+    it = m_clients.find(socket);
+    if (it == m_clients.end() || socket->state() != QLocalSocket::ConnectedState) return;
+  }
+}
+
+void DeskToolboxControl::write(QLocalSocket *socket, const QJsonObject &object)
+{
+  if (!m_clients.contains(socket) || socket->state() != QLocalSocket::ConnectedState) return;
+  const auto bytes = QJsonDocument(object).toJson(QJsonDocument::Compact) + '\n';
+  if (bytes.size() > MaxFrame || socket->bytesToWrite() > 4 * MaxFrame) { socket->abort(); return; }
+  socket->write(bytes);
+  socket->flush();
+}
+
+void DeskToolboxControl::reject(QLocalSocket *socket, const QString &id, const QString &reason)
+{
+  write(socket, {{"version", 1}, {"requestId", id}, {"ok", false},
+                 {"activeComputer", ""}, {"connectedComputers", QJsonArray{}},
+                 {"revision", 0}, {"error", reason}});
+}
+
+void DeskToolboxControl::processFrame(QLocalSocket *socket, const QByteArray &frame)
+{
+  QJsonParseError error;
+  const auto doc = QJsonDocument::fromJson(frame, &error);
+  if (error.error != QJsonParseError::NoError || !doc.isObject()) {
+    reject(socket, {}, "invalid_json"); return;
+  }
+  const auto request = doc.object();
+  const auto id = request.value("requestId").toString();
+  static const QRegularExpression idPattern(QStringLiteral("\\A[0-9a-fA-F]{32}\\z"));
+  if (!idPattern.match(id).hasMatch()) { reject(socket, {}, "invalid_request_id"); return; }
+  if (!request.value("version").isDouble() || request.value("version").toDouble() != 1) {
+    reject(socket, id, "unsupported_version"); return;
+  }
+  const auto action = request.value("action").toString();
+  if (action != "state" && action != "switch") { reject(socket, id, "invalid_action"); return; }
+  const auto target = request.value("target");
+  if (action == "switch" && (!target.isString() || target.toString().isEmpty() || target.toString().toUtf8().size() > 255)) {
+    reject(socket, id, "invalid_target"); return;
+  }
+  for (const auto &key : request.keys()) {
+    if (key != "version" && key != "requestId" && key != "action" && key != "target") {
+      reject(socket, id, "unknown_field"); return;
+    }
+  }
+  auto &client = m_clients[socket];
+  if (client.pending.contains(id)) { reject(socket, id, "duplicate_request_id"); return; }
+  if (client.pending.size() >= 8) { reject(socket, id, "too_many_requests"); return; }
+  client.pending.insert(id);
+  const QPointer<QLocalSocket> guard(socket);
+  m_submit(request, [this, guard, id](QJsonObject response) {
+    QMetaObject::invokeMethod(this, [this, guard, id, response = std::move(response)]() mutable {
+      if (!guard || !m_clients.contains(guard)) return;
+      m_clients[guard].pending.remove(id);
+      response.insert("version", 1);
+      response.insert("requestId", id);
+      write(guard, response);
+    }, Qt::QueuedConnection);
+  });
+}
+
+void DeskToolboxControl::publish(QJsonObject snapshot, bool focusChanged)
+{
+  QMetaObject::invokeMethod(this, [this, snapshot = std::move(snapshot), focusChanged]() mutable {
+    snapshot.insert("version", 1);
+    snapshot.insert("event", focusChanged ? "focusChanged" : "stateChanged");
+    for (auto *socket : m_clients.keys()) write(socket, snapshot);
+  }, Qt::QueuedConnection);
+}
