diff --git a/src/lib/deskflow/control/PeerIdentityBindings.h b/src/lib/deskflow/control/PeerIdentityBindings.h
new file mode 100644
--- /dev/null
+++ b/src/lib/deskflow/control/PeerIdentityBindings.h
@@ -0,0 +1,52 @@
+/*
+ * DesktopToolbox integration for Deskflow.
+ * SPDX-FileCopyrightText: (C) 2026 DesktopToolbox contributors
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+#pragma once
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QSet>
+
+class PeerIdentityBindings
+{
+public:
+  static bool allows(const QString &path, const QString &name, const QByteArray &actualFingerprint)
+  {
+    static const QRegularExpression validName(QStringLiteral("\\A[A-Za-z0-9_.-]{1,64}\\z"));
+    static const QRegularExpression validFingerprint(QStringLiteral("\\A[0-9A-Fa-f]{64}\\z"));
+    const auto actual = QString::fromLatin1(actualFingerprint).toUpper();
+    if (!validName.match(name).hasMatch() || !validFingerprint.match(actual).hasMatch() ||
+        path.isEmpty() || QFileInfo(path).isSymLink()) return false;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() <= 0 || file.size() > 65536) return false;
+    QJsonParseError error;
+    const auto document = QJsonDocument::fromJson(file.readAll(), &error);
+    if (error.error != QJsonParseError::NoError || !document.isObject()) return false;
+    const auto root = document.object();
+    const auto peers = root.value("peers");
+    if (root.value("version").toInt(-1) != 1 || !peers.isArray() || peers.toArray().size() > 4) return false;
+    QSet<QString> names;
+    QSet<QString> fingerprints;
+    bool matched = false;
+    for (const auto &value : peers.toArray()) {
+      if (!value.isObject()) return false;
+      const auto entry = value.toObject();
+      const auto peerName = entry.value("name");
+      const auto peerFingerprint = entry.value("fingerprint");
+      if (!peerName.isString() || !peerFingerprint.isString()) return false;
+      const auto n = peerName.toString();
+      const auto f = peerFingerprint.toString().toUpper();
+      if (!validName.match(n).hasMatch() || !validFingerprint.match(f).hasMatch() ||
+          names.contains(n.toLower()) || fingerprints.contains(f)) return false;
+      names.insert(n.toLower());
+      fingerprints.insert(f);
+      if (n.compare(name, Qt::CaseInsensitive) == 0 && f == actual) matched = true;
+    }
+    return matched;
+  }
+};
