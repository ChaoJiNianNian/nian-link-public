+std::string SecureSocket::peerFingerprintSha256()
+{
+  std::scoped_lock ssl_lock{ssl_mutex_};
+  if (!m_secureReady || !m_ssl || !m_ssl->m_ssl || m_securityLevel != SecurityLevel::PeerAuth) return {};
+  const auto cert = SSL_get_peer_certificate(m_ssl->m_ssl);
+  if (!cert) return {};
+  const auto sha256 = deskflow::sslCertFingerprint(cert, QCryptographicHash::Sha256);
+  X509_free(cert);
+  return sha256.isValid() ? deskflow::formatSSLFingerprint(sha256.data, false).toStdString() : std::string{};
+}
