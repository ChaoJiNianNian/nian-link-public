diff --git a/src/lib/deskflow/control/PreviewInputIsolation.h b/src/lib/deskflow/control/PreviewInputIsolation.h
new file mode 100644
--- /dev/null
+++ b/src/lib/deskflow/control/PreviewInputIsolation.h
@@ -0,0 +1,24 @@
+/*
+ * DesktopToolbox preview input isolation for Deskflow.
+ * SPDX-FileCopyrightText: (C) 2026 DesktopToolbox contributors
+ * SPDX-License-Identifier: GPL-2.0-only WITH LicenseRef-OpenSSL-Exception
+ */
+
+#pragma once
+#include <cstdint>
+
+namespace deskflow::preview {
+inline constexpr std::uintptr_t EventMarker = 0x4e505256u; // NPRV, also valid on Win32.
+inline constexpr bool isTaggedPreviewInput(bool injected, std::uintptr_t extraInfo)
+{
+  return injected && extraInfo == EventMarker;
+}
+inline constexpr bool inputIsolated()
+{
+#ifdef _WIN32
+  return true;
+#else
+  return false;
+#endif
+}
+} // namespace deskflow::preview
